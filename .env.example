# Copy to .env (repo root) and fill in. See README for where each value comes from.

# OAuth client (Google Cloud Console → APIs & Services → Credentials → OAuth client, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Printed by `npm run auth:init`
GOOGLE_REFRESH_TOKEN=

# Name of the Drive folder the app creates for uploads (it's found again by tag, even if you rename it)
DRIVE_FOLDER_NAME=File QR Uploads

# Shared password for the web UI (min 8 chars)
APP_PASSWORD=

# Random string, min 32 chars, used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Max upload size in megabytes
MAX_UPLOAD_MB=50

# Port for the Express server (the Vite dev server on 5173 proxies /api here)
PORT=3001

# Optional, production only: set to 1 when running behind one reverse proxy (nginx, Caddy, etc.)
# so HTTPS is detected (Secure cookie) and rate limits see real client IPs.
# TRUST_PROXY=1
